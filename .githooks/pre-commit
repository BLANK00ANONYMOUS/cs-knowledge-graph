#!/bin/sh
# Validate the knowledge graph before every commit (installed by setup.ps1 via core.hooksPath).
ROOT="$(git rev-parse --show-toplevel)"
PY="$ROOT/.venv/Scripts/python.exe"
[ -x "$PY" ] || PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || { echo "kg: .venv missing, run setup.ps1 (skipping check)"; exit 0; }
"$PY" "$ROOT/tools/kg.py" check || { echo "kg check failed - fix the vault or commit with --no-verify"; exit 1; }