.venv/
__pycache__/
.kg/
build/
/books/
*.pdf
vault/.obsidian/workspace*.json
vault/.obsidian/cache

# notes synced from whoever's GitHub account is connected: personal, regenerated by Sync, never published
vault/projects/gh-*.md
vault/contributions/pr-*.md
vault/contributions/issue-*.md

# target roles: companies, levels and application status are personal
vault/roles/*
!vault/roles/.gitkeep

# your own books: indexed locally, never published
vault/books/*
!vault/books/.gitkeep
# challenge workspaces and rating history are per machine (hidden tests live in .kg/ on the same machine)
challenges/
plans/
journal/*.md
!journal/README.md
